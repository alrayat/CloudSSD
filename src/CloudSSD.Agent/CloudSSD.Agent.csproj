<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when started at logon or by the desktop app. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>CloudSSD.Agent</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CloudSSD.Agent</RootNamespace>
    <ApplicationIcon>..\CloudSSD.Desktop\Assets\cloudssd.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The agent lives next to the WPF app, whose folder carries Microsoft.Win32.SystemEvents from the Windows Desktop
         framework rather than the NuGet package; use the same framework so it always resolves (measured: the worker
         crashed with FileNotFoundException when started from the app folder without this). -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CloudSSD.App\CloudSSD.App.csproj" />
  </ItemGroup>
</Project>
