<UserControl x:Class="CloudSSD.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CloudSSD.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <Border Background="{StaticResource Rail}" CornerRadius="16" Padding="24,22" Margin="0,0,14,18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="CLOUDSSD / YOUR PERSONAL STORAGE" FontSize="10" Foreground="{StaticResource Lime}" FontWeight="SemiBold" />
                        <TextBlock Text="More space. Closer to you." FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource RailText}" TextWrapping="Wrap" Margin="0,8,0,7" />
                        <TextBlock Text="Cloud folders in File Explorer. The data you use, cached on your SSD." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RailMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Manage cloud drives" Command="{Binding GoCommand}" CommandParameter="Cloud Drives" Background="{StaticResource Lime}" BorderBrush="{StaticResource Lime}" Foreground="{StaticResource Rail}" Margin="0,0,0,8" />
                        <Button Content="Open game library" Command="{Binding GoCommand}" CommandParameter="Game Library" Background="Transparent" BorderBrush="{StaticResource RailMuted}" Foreground="{StaticResource RailText}" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- KPI row -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding HealthTone, Converter={StaticResource Tone}}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            <TextBlock Text="CONNECTION HEALTH" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Health}" Style="{StaticResource Body}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding HealthTone, Converter={StaticResource Tone}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Accent}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            <TextBlock Text="CACHE ON SSD" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="{Binding CacheUsage}" Style="{StaticResource Metric}" />
                        <ProgressBar Value="{Binding CacheFraction}" Maximum="1" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Gold}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            <TextBlock Text="CACHE HIT RATE" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="{Binding HitRate}" Style="{StaticResource Metric}" Foreground="{StaticResource Gold}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource PurpleHover}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            <TextBlock Text="PREDICTION ENGINE" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="{Binding EngineState}" Style="{StaticResource Metric}" Foreground="{StaticResource PurpleHover}" />
                        <TextBlock Text="{Binding GameState}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Setup checklist -->
            <Border Style="{StaticResource Card}" Visibility="{Binding SetupComplete, Converter={StaticResource NotVis}}" BorderBrush="{StaticResource Accent}">
                <StackPanel>
                    <TextBlock Text="Get started" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Setup}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Width="22" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEA3A;" />
                                                <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                        <Setter Property="Text" Value="&#xE930;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Primary}" Content="Cloud Drives" Command="{Binding GoCommand}" CommandParameter="Cloud Drives" />
                        <Button Content="Game Library" Command="{Binding GoCommand}" CommandParameter="Game Library" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Warnings -->
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" BorderBrush="{Binding Tone, Converter={StaticResource Tone}}">
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Key}" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource Tone}}" /><Run Text="  " /><Run Text="{Binding Value}" Foreground="{StaticResource Muted}" /></TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding TransferRate}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            <TextBlock Text="Network activity · last 2 minutes" Style="{StaticResource H2}" />
                        </DockPanel>
                        <c:Sparkline Values="{Binding RateHistory}" Height="130" Stroke="{StaticResource Accent}" Capacity="120" />
                        <TextBlock Text="{Binding EngineDetail}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Storage" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding FreeSpace}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding CacheDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cloud accounts" Style="{StaticResource H2}" />
                        <TextBlock Text="No accounts connected." Style="{StaticResource Caption}" Visibility="{Binding Accounts.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Width="140" />
                                        <TextBlock Text="{Binding Value}" Foreground="{StaticResource Muted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Virtual drives" Style="{StaticResource H2}" />
                        <TextBlock Text="No drives configured." Style="{StaticResource Caption}" Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Margin="2,0,14,0"
                       Text="All figures are measured live from rclone and the CloudSSD engine. Values without a real source are shown as 'Unavailable'. Uncached data always depends on your internet speed: at 70 Mbps the cloud delivers at most ≈ 8.75 MB/s." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
