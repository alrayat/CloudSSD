<Window x:Class="CloudSSD.Desktop.Views.TeraBoxWebSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to TeraBox (unofficial connection)" Width="1000" Height="760" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}" SizeToContent="Manual">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="26,20" BorderBrush="{StaticResource Warning}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Unofficial TeraBox connection" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Without TeraBox developer keys, CloudSSD can use the TeraBox website's own interface with your signed-in session. TeraBox's terms do not allow non-public interfaces, so TeraBox could limit or suspend an account that uses this. CloudSSD never sees or stores your password, solves no captchas and does not get around any TeraBox limit. Your session is stored encrypted for your Windows account only, and the sign-in browser data is cleared afterwards." />
                <StackPanel x:Name="ConsentPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="Consent" Content="I understand the risk and want to connect my own TeraBox account this way" VerticalAlignment="Center" />
                    <Button x:Name="ContinueButton" Content="Continue to TeraBox sign-in" Style="{StaticResource Primary}" Margin="14,0,0,0" Click="Continue"
                            IsEnabled="{Binding IsChecked, ElementName=Consent}" />
                </StackPanel>
                <DockPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" x:Name="ConnectButton" Content="I'm signed in — connect" Click="ConnectNow" />
                    <TextBlock x:Name="Status" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Sign in to TeraBox below (email, Google or any method TeraBox offers). CloudSSD connects automatically once you are signed in." />
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
            <TextBlock x:Name="Placeholder" Text="The TeraBox website opens here after you continue." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" />
        </Grid>
    </DockPanel>
</Window>
