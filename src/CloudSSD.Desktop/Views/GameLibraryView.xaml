<UserControl x:Class="CloudSSD.Desktop.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
                <Button Style="{StaticResource Primary}" Command="{Binding AddGameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add cloud game" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportGameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import from this PC" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="{Binding LibraryCount}" Style="{StaticResource Label}" />
                <Grid>
                    <TextBox x:Name="LibrarySearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search games" ToolTip="Filter your library by game name" />
                    <TextBlock Text="Search games…" Foreground="{StaticResource Dim}" FontSize="12" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource NotVis}}" />
                </Grid>
                <TextBlock Text="No matching games. Try another name." Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding NoSearchResults, Converter={StaticResource Vis}}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Your library is empty. Mount a drive, then add a game folder." Style="{StaticResource Caption}"
                       Visibility="{Binding Games.Count, Converter={StaticResource NotVis}}" />
            <ListBox ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border Width="44" Height="44" CornerRadius="9" Background="{StaticResource PurpleSoft}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Mode}" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding Readiness}" Foreground="{Binding ReadinessTone, Converter={StaticResource Tone}}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="18,0,0,0" VerticalAlignment="Top" Padding="36" Visibility="{Binding HasSelection, Converter={StaticResource NotVis}}">
            <StackPanel><TextBlock Text="A home for your games." Style="{StaticResource H1}" /><TextBlock Text="Select a game to see its readiness, launch options and compatibility report. Add a folder from a mounted cloud drive, or import an installed game from this PC." Style="{StaticResource Caption}" Margin="0,8,0,18" /><Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="16"><TextBlock Text="Cloud Direct · Hybrid Optimized · Full Local" Foreground="{StaticResource Accent}" FontWeight="SemiBold" /></Border></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource Play}" Command="{Binding PlayCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource NotBool}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="PLAY" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.Name}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding Selected.Compat}" FontSize="11.5" Foreground="{Binding Selected.CompatTone, Converter={StaticResource Tone}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Selected.Readiness}" FontSize="11.5" Foreground="{Binding Selected.ReadinessTone, Converter={StaticResource Tone}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Selected.Mode}" FontSize="11.5" Foreground="{StaticResource Accent}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding ReadinessDetail}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"><Run Text="Last launch: " Foreground="{StaticResource Dim}" /><Run Text="{Binding LastResult}" /></TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="After caching:" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox Width="200" ItemsSource="{Binding CompletionChoices}" SelectedIndex="{Binding CompletionChoice}" /></StackPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Command="{Binding PrepareCommand}" Style="{StaticResource Primary}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Optimize &amp; Prepare" />
                                </StackPanel>
                            </Button>
                            <Button Content="{Binding FullCacheLabel}" Command="{Binding FullyCacheCommand}" Margin="0,0,8,6"
                                    ToolTip="Fully cached mode: download the whole game into the local cache before playing (uses the game's full size on your disk)." />
                            <Button Content="Game settings" Command="{Binding SettingsCommand}" Margin="0,0,8,6" />
                            <Button Content="Pause download" Command="{Binding PauseDownloadsCommand}" Margin="0,0,8,6" />
                            <Button Content="Resume download" Command="{Binding ResumeDownloadsCommand}" Margin="0,0,8,6" />
                            <Button Content="Install locally…" Command="{Binding InstallLocallyCommand}" Margin="0,0,8,6" />
                            <Button Content="Re-analyze" Command="{Binding ReanalyzeCommand}" Margin="0,0,8,6" />
                            <Button Content="Reset profile" Style="{StaticResource Ghost}" Command="{Binding ResetProfileCommand}" Margin="0,0,8,6" />
                            <Button Content="Remove from library" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Compatibility report" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,12,2"
                                                Background="{Binding Severity, Converter={StaticResource Tone}, ConverterParameter=sev}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Caption}" Visibility="{Binding Suggestion, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Key}" Width="150" Foreground="{StaticResource Dim}" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
