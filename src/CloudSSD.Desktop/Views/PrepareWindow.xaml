<Window x:Class="CloudSSD.Desktop.Views.PrepareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimize &amp; Prepare" Width="680" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="30,26">
        <TextBlock Text="PREPARE FOR PLAY" Style="{StaticResource Label}" Margin="0,0,0,14" />
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
        <TextBlock Text="Checks the game, measures your connection and caches the data needed for startup." Style="{StaticResource Caption}" Margin="0,0,0,16" />
        <ItemsControl x:Name="Steps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="26" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,0,0" Text="{Binding Icon}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="PrefetchPanel" Visibility="Collapsed" Margin="26,0,0,10">
            <ProgressBar x:Name="PrefetchBar" Maximum="1" />
            <TextBlock x:Name="PrefetchText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
        <Border x:Name="ResultBox" Visibility="Collapsed" CornerRadius="12" BorderThickness="1" Padding="14,10" Background="{StaticResource Surface}" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
