<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CloudSSD.Desktop.Views.CloudDrivesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,20">
      <WrapPanel Margin="0,0,0,18">
        <Button Style="{StaticResource Primary}" Command="{Binding ConnectGoogleDriveCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Sign in with Google Drive" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ConnectTeraBoxCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Connect TeraBox" />
          </StackPanel>
        </Button>
        <Button Content="Add virtual drive" Command="{Binding AddDriveCommand}" CommandParameter="{x:Null}" />
      </WrapPanel>
      <TextBlock Text="{Binding TeraBoxStatus}" Style="{StaticResource Caption}" Margin="0,-6,0,12" TextWrapping="Wrap" />
      <TextBlock Text="Virtual drives" Style="{StaticResource H2}" />
      <TextBlock Text="{Binding PermanentStatus}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="{Binding PermanentStatus, Converter={StaticResource Vis}}" />
      <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}" Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Your next drive lives in the cloud." Style="{StaticResource H2}" Margin="0,0,0,6" /><TextBlock Text="Connect Google Drive or TeraBox above, then choose a folder and a drive letter. It will appear alongside your local drives in File Explorer." Style="{StaticResource Caption}" /></StackPanel>
        </Grid>
      </Border>
      <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Grid.Row="0" Grid.RowSpan="2" Width="52" Height="52" CornerRadius="10" Background="{StaticResource Surface3}" Margin="0,0,16,0">
                <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <WrapPanel>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
                  <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Remote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                <WrapPanel>
                  <Button Content="Set up in Steam" Padding="8,4" Command="{Binding DataContext.SetupSteamCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" ToolTip="Check this library and open Steam Storage if it needs to be added on this PC." />
                  <Button Content="Repair stalled Steam recovery" Padding="8,4" Command="{Binding DataContext.RepairSteamRecoveryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding CanRepair, Converter={StaticResource Vis}}" ToolTip="Temporarily takes the drive offline, preserves incomplete Steam writes separately, then remounts the drive." />
                  <Button Content="Resume saved writes" Padding="8,4" Command="{Binding DataContext.ResumeSteamRecoveryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding HasPausedWrites, Converter={StaticResource Vis}}" ToolTip="Restores preserved Steam writes. The drive may wait for missing cloud data during recovery." />
                </WrapPanel>
                <CheckBox Content="Keep Cloud SSD Permanent" Margin="0,6,0,0" IsChecked="{Binding IsPermanent, Mode=OneWay}" Command="{Binding DataContext.TogglePermanentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="On: the drive stays mounted when CloudSSD is closed and returns automatically after you sign in to Windows. Off: it is unmounted when idle and does not return after a restart. Cloud files, login and cache are never deleted." />
              </StackPanel>
              <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                <Button Margin="0,0,8,6" Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                <Button Margin="0,0,8,6" Content="Refresh listing" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                <Button Margin="0,0,8,6" Content="Unmount" Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                <Button Margin="0,0,8,6" Content="Mount" Style="{StaticResource Primary}" Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding CanMount, Converter={StaticResource Vis}}" />
                <Button Margin="0,0,8,6" Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveDriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
              </WrapPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Connected accounts" Style="{StaticResource H2}" />
            <TextBlock Text="None yet." Style="{StaticResource Caption}" Visibility="{Binding Accounts.Count, Converter={StaticResource NotVis}}" />
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="Disconnect" Style="{StaticResource Ghost}" Padding="8,3" Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    <Button DockPanel.Dock="Right" Content="Add drive" Style="{StaticResource Ghost}" Padding="8,3" Command="{Binding DataContext.AddDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}" />
                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Width="130" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <Expander Header="Provider support and details" IsExpanded="False">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding ProviderRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Support}" Margin="10,0,0,0" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>