<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CloudSSD.Desktop.Views.AcceleratorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudSSD.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,20">
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right" Content="Predictive prefetching" IsChecked="{Binding PredictionEnabled}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{Binding Session}" Style="{StaticResource Body}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Policy}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <UniformGrid Columns="3">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Hit rate per second" Style="{StaticResource H2}" />
            <c:Sparkline Values="{Binding HitHistory}" MaxValue="1" Height="100" Stroke="{StaticResource Success}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Average read wait (ms)" Style="{StaticResource H2}" />
            <c:Sparkline Values="{Binding WaitHistory}" Height="100" Stroke="{StaticResource Warning}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Prefetch queue" Style="{StaticResource H2}" />
            <c:Sparkline Values="{Binding QueueHistory}" Height="100" Stroke="{StaticResource Purple}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <UniformGrid Columns="5">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CACHE HITS" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding Hits}" Style="{StaticResource Metric}" Foreground="{StaticResource Success}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CACHE MISSES" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding Misses}" Style="{StaticResource Metric}" Foreground="{StaticResource Warning}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="HIT RATE" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding HitRate}" Style="{StaticResource Metric}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="AVERAGE READ WAIT" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding AvgWait}" Style="{StaticResource Metric}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="LONGEST STALL" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding LongestStall}" Style="{StaticResource Metric}" />
            <TextBlock Text="{Binding Stalls}" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Prediction activity" Style="{StaticResource H2}" />
            <ItemsControl ItemsSource="{Binding Queue}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock Text="{Binding Key}" Width="150" Foreground="{StaticResource Dim}" />
                    <TextBlock Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,10,0,2">
              <TextBlock Text="Accuracy" Width="150" Foreground="{StaticResource Dim}" />
              <TextBlock Text="{Binding Accuracy}" />
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock Text="Useful prefetch" Width="150" Foreground="{StaticResource Dim}" />
              <TextBlock Text="{Binding Useful}" Foreground="{StaticResource Success}" />
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock Text="Wasted prefetch" Width="150" Foreground="{StaticResource Dim}" />
              <TextBlock Text="{Binding Wasted}" Foreground="{StaticResource Warning}" />
            </DockPanel>
            <TextBlock Text="Predictors (this session)" Style="{StaticResource H2}" Margin="0,16,0,6" />
            <ItemsControl ItemsSource="{Binding Predictors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="90" />
                      <TextBlock Text="{Binding State}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}">
                      <Run Text="issued " />
                      <Run Text="{Binding Issued}" />
                      <Run Text=" · useful " />
                      <Run Text="{Binding Useful}" />
                      <Run Text=" · wasted " />
                      <Run Text="{Binding Wasted}" />
                      <Run Text=" · accuracy " />
                      <Run Text="{Binding Accuracy}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Live game reads (from rclone telemetry)" Style="{StaticResource H2}" />
            <TextBlock Text="No application reads observed yet." Style="{StaticResource Caption}" Visibility="{Binding Reads.Count, Converter={StaticResource NotVis}}" />
            <ItemsControl ItemsSource="{Binding Reads}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="92" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="74" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Dim}" />
                    <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="11.5" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Wait}" FontSize="11.5" />
                    <TextBlock Grid.Column="3" Text="{Binding Range}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Grid.Column="4" Text="{Binding Path}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Style="{StaticResource Caption}" Text="Hits and misses are rclone's own cache verdict for each read; wait times are measured between the read request and its completion. Prefetch reads by CloudSSD are excluded from these figures." />
    </StackPanel>
  </ScrollViewer>
</UserControl>