<Window x:Class="CloudSSD.Desktop.Views.CompletionActionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CloudSSD.Desktop.Views"
 Title="After completion" Width="720" Height="650" SizeToContent="Manual" WindowStartupLocation="CenterOwner"
 Style="{StaticResource DialogWindow}">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="AUTOMATE THE FINISH" Style="{StaticResource Label}" Margin="0,0,0,14" />
   <TextBlock Text="After completion" Style="{StaticResource H1}" />
   <TextBlock Text="Choose what happens after Steam finishes installing a game. For imports and app downloads, choose the action before starting the transfer."
    Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
   <TextBlock Text="STEAM GAME" Style="{StaticResource Label}" />
   <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshGames" />
    <ComboBox x:Name="SteamGames" DisplayMemberPath="Name" /></DockPanel>
   <local:CompletionActionPicker x:Name="AfterCompletion" />
   <Button Content="Apply to this installation" Click="Schedule" HorizontalAlignment="Left" Style="{StaticResource Primary}" />
   <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,14" />
   <TextBlock Text="Scheduled actions" Style="{StaticResource H2}" />
  </StackPanel>
  <Button DockPanel.Dock="Bottom" Content="Close" Click="CloseClick" HorizontalAlignment="Right" Margin="0,12,0,0" />
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="Jobs">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Margin="0,0,0,8"><DockPanel>
      <Button DockPanel.Dock="Right" Content="Cancel" Tag="{Binding Id}" Click="CancelJob" VerticalAlignment="Top" />
      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,5,0,0" />
      </StackPanel>
     </DockPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </DockPanel>
</Window>
