+	}
+	item.downloaders = downloaders.New(ctx, item, item.c.opt, item.name, item.o)
+	err = item._ensure(0, item.info.Size)
+	if err == nil && !item.info.Rs.Present(ranges.Range{Pos: 0, Size: item.info.Size}) {
+		err = errors.New("vfs cache: missing ranges remain after deferred hydration; refusing upload")
+	}
+	dls := item.downloaders
+	item.downloaders = nil
+	unlockMutexForCall(&item.mu, func() {
+		if closeErr := dls.Close(nil); err == nil {
+			err = closeErr
+		}
+	})
+	if closeErr := item.fd.Close(); err == nil {
+		err = closeErr
+	}
+	item.fd = nil
+	if saveErr := item._save(); err == nil {
+		err = saveErr
+	}
+	if err != nil {
+		return fmt.Errorf("vfs cache: deferred hydration: %w", err)
+	}
+	return ctx.Err()
+}
