+// _hydrateForStore fills sparse ranges while holding an internal cache handle.
+// The caller holds item.mu. Reopening cancels hydration and waits only for
+// cancellation/handle cleanup, so reads of cached bytes do not wait on the cloud.
+func (item *Item) _hydrateForStore(ctx context.Context) (err error) {
+	ctx, cancel := context.WithCancel(ctx)
+	item.mergeCancel = cancel
+	item.closing = make(chan struct{})
+	defer func() {
+		cancel()
+		item.mergeCancel = nil
+		close(item.closing)
+		item.closing = nil
+	}()
+	if err = ctx.Err(); err != nil {
+		return err
+	}
